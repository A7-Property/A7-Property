# Local development template. Copy to backend/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://a7:replace-me@localhost:5432/a7_property
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=true
APP_VERSION=dev

# Storage: local disk in development, Cloudflare R2 in production.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Mail: "log" prints verification/reset links to the backend log instead of sending them.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Rate limiting. Without REDIS_URL the counters are per-process, which is only
# correct on a single replica. Set it once you run more than one.
REDIS_URL=
THROTTLE_LIMIT=60
THROTTLE_TTL_SECONDS=60

# Brute-force protection. Counters live in PostgreSQL, so every replica shares them.
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=30

# Scheduled maintenance. Leave ENABLE_JOBS=true on exactly one replica.
ENABLE_JOBS=true
UPLOAD_ORPHAN_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=365

# Connection pool and query ceiling per replica.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# First administrator (see README). Development/staging only here.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
