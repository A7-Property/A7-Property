# Template only. Store real values in your host's secret manager, never in Git.
NODE_ENV=production
PORT=4000

# TLS to the database is enforced at boot: sslmode must be require, verify-ca or verify-full.
DATABASE_URL=postgresql://USER:REPLACE_PASSWORD@DB_HOST:5432/a7_property?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Two different secrets, each 32+ random characters. Rotating them signs everyone out.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHARACTERS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

FRONTEND_URL=https://APP_DOMAIN
BACKEND_PUBLIC_URL=https://API_DOMAIN
COOKIE_SECURE=true
# The exact number of reverse proxies in front of this service, never a guess:
# trusting more hops lets a client forge its own IP for rate limits and audit logs.
TRUST_PROXY_HOPS=1
ENABLE_SWAGGER=false
APP_VERSION=REPLACE_WITH_RELEASE_SHA

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_KEY
R2_BUCKET_NAME=BUCKET_NAME
# Separate bucket with public access disabled; required for identity/ownership uploads.
R2_PRIVATE_BUCKET_NAME=PRIVATE_BUCKET_NAME
R2_PUBLIC_URL=https://IMAGE_DOMAIN

MAIL_DRIVER=smtp
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_FROM="A7 Property <hello@APP_DOMAIN>"

# Required once more than one replica runs, otherwise each one allows the full quota.
REDIS_URL=rediss://REPLACE_REDIS_HOST:6380
THROTTLE_LIMIT=60
THROTTLE_TTL_SECONDS=60

LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=30

# Exactly one replica should run the scheduler; set ENABLE_JOBS=false on the others.
ENABLE_JOBS=true
UPLOAD_ORPHAN_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=365

# Never seed the demo catalog into real inventory.
ALLOW_DEMO_CATALOG_SEED=false

# Set only for the one-off `npm run db:bootstrap-admin` run, then remove from the environment.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
