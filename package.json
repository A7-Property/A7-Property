{
  "name": "a7-property-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "build:android:web": "node scripts/build-capacitor-web.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "npm run android:sync && node scripts/run-android-gradle.mjs assembleDebug",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "start:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node scripts/test-frontend.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "fullstack:setup": "node scripts/local-fullstack.mjs setup",
    "fullstack:dev": "node scripts/local-fullstack.mjs dev",
    "fullstack:status": "node scripts/local-fullstack.mjs status",
    "fullstack:stop": "node scripts/local-fullstack.mjs stop",
    "fullstack:test": "node scripts/test-local-fullstack.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-accessibility": "^9.0.0-rc02",
    "embla-carousel-react": "^9.0.0-rc02",
    "framer-motion": "^12.42.2",
    "framework7": "^9.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.5.1",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "miniflare": "5.20261012.0-beta",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.16.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "fflate": "^0.8.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
